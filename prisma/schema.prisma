// Prisma schema for indiecomicslive.
// PG17 target. Run `npm run db:generate` to regenerate the client,
// `npm run db:migrate` to author + apply a migration in dev.

// Prisma 7: client output is project-local, datasource url moves to
// prisma.config.ts so the schema is purely declarative.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  viewer
  seller
  admin
  super_admin
}

enum ShowStatus {
  scheduled
  live
  ended
  cancelled
}

enum LotStatus {
  queued
  live
  sold
  unsold
}

enum LotKind {
  auction      // Standard timed-bid auction lot.
  buy_now      // Fixed price; first buyer wins.
  mystery      // Buy-now flow but contents are hidden until purchase.
}

enum OrderStatus {
  pending_payment
  payment_failed
  paid
  shipped
  delivered
  refunded
  cancelled
}

enum PaymentProcessor {
  nmi
  divinitycoin
}

// Singleton row keyed by id="default". Holds platform-wide settings
// the admin can flip from /admin/settings — currently used to switch
// the active payment processor between NMI (PaymentCloud) and
// DivinityCoin, and to store DC API credentials.
model PlatformSetting {
  id String @id @default("default")

  activeProcessor PaymentProcessor @default(nmi) @map("active_processor")

  divinityCoinEnabled       Boolean @default(false) @map("divinitycoin_enabled")
  // DC issues three separate sk_-prefixed tokens per partner:
  //   apiKey      — generic Partner API access (Bearer)
  //   publicKey   — surfaced in client requests for low-trust ops
  //   privateKey  — used to sign sensitive partner operations
  // Stored as plaintext in DB; admin enters via /admin/settings/payments.
  divinityCoinApiKey        String? @map("divinitycoin_api_key")
  divinityCoinPublicKey     String? @map("divinitycoin_public_key")
  divinityCoinPrivateKey    String? @map("divinitycoin_private_key")
  divinityCoinPartnerId     String? @map("divinitycoin_partner_id")
  divinityCoinWebhookSecret String? @map("divinitycoin_webhook_secret")
  divinityCoinBaseUrl       String? @map("divinitycoin_base_url")

  // Google reCAPTCHA v2 ("I'm not a robot" checkbox). Surfaced on
  // /sign-in, /sign-up, and /forgot-password when enabled. Set keys
  // at /admin/settings/recaptcha.
  recaptchaEnabled   Boolean @default(false) @map("recaptcha_enabled")
  recaptchaSiteKey   String? @map("recaptcha_site_key")
  recaptchaSecretKey String? @map("recaptcha_secret_key")

  // Shippo. Master account model — one live token here, sellers
  // print labels through our UI. Webhook secret is the shared token
  // we put in the Shippo dashboard webhook URL. Configure at
  // /admin/settings/shipping. Fallback to SHIPPO_API_KEY /
  // SHIPPO_WEBHOOK_SECRET env vars when these are null.
  shippoApiKey       String? @map("shippo_api_key")
  shippoWebhookSecret String? @map("shippo_webhook_secret")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_settings")
}

// User-to-user direct messages. Threaded by Conversation (one row
// per pair of users). Participant ids are stored sorted (A < B
// lexicographically) so we can use a unique index for "find or
// create" lookups.
model Conversation {
  id              String   @id @default(uuid()) @db.Uuid
  participantAId  String   @map("participant_a_id") @db.Uuid
  participantBId  String   @map("participant_b_id") @db.Uuid
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  lastMessagePreview String? @map("last_message_preview")
  createdAt       DateTime @default(now()) @map("created_at")

  participantA User      @relation("ConvA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User      @relation("ConvB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, lastMessageAt])
  @@index([participantBId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("Sender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// One-shot password-reset tokens. Created when a user submits the
// forgot-password form; consumed (deleted) when they POST a new
// password. SHA-256 of the token is stored — the raw token only ever
// exists in the email link.
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  consumedAt DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum SellerApplicationStatus {
  draft
  submitted
  under_review
  needs_revision
  approved
  rejected
}

// User shape follows Auth.js v5 + Prisma adapter expectations
// (id, name, email, emailVerified, image). Custom fields live alongside.
// Pattern + extra fields ported from indiecrowdfund_2.0/prisma/schema/user.prisma.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  heroImage     String?   @map("hero_image")
  handle        String?   @unique
  vanityUrl     String?   @unique @map("vanity_url")
  bio           String?
  location      String?
  timezone      String?
  websites      String[]
  socialLinks   Json?     @map("social_links")
  showNameOnly  Boolean   @default(false) @map("show_name_only")
  role          UserRole  @default(viewer)

  dateOfBirth   DateTime? @map("date_of_birth")

  // Password authentication. scrypt-hashed string in the format
  // produced by src/lib/admin-password.ts (`scrypt.<N>.<r>.<p>.<saltB64url>.<keyB64url>`).
  // Nullable so legacy users created before password auth can still
  // exist; they'll be prompted to set a password on first sign-in.
  passwordHash       String?   @map("password_hash")

  // Email preferences
  emailUnsubscribedAt DateTime? @map("email_unsubscribed_at")

  // Chat moderation
  chatBannedAt   DateTime? @map("chat_banned_at")
  chatBannedById String?   @map("chat_banned_by_id") @db.Uuid
  chatBanReason  String?   @map("chat_ban_reason")

  // Account locking (fraud / abuse)
  lockedAt     DateTime? @map("locked_at")
  lockedReason String?   @map("locked_reason")
  lockedById   String?   @map("locked_by_id") @db.Uuid
  lastKnownIP  String?   @map("last_known_ip")

  // Failed login tracking
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")

  // Soft delete (mod-initiated, reversible)
  deletedAt DateTime? @map("deleted_at")
  // Hard self-delete (irreversible — wipes PII, keeps name/email for
  // seller's order records; cancels pending orders).
  accountDeletedAt DateTime? @map("account_deleted_at")

  bannedAt  DateTime? @map("banned_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  accounts          Account[]
  seller            Seller?
  sellerApplication SellerApplication?
  bankAccount       PaymentCloudBankAccount?
  chargebackCard    SellerChargebackCard?
  shows             Show[]              @relation("SellerShows")
  bids              Bid[]
  ordersAsBuyer     Order[]             @relation("Buyer")
  ordersAsSeller    Order[]             @relation("Seller")
  lotsAsSeller      Lot[]               @relation("LotSeller")
  payouts           Payout[]            @relation("PayoutSeller")
  conversationsA    Conversation[]      @relation("ConvA")
  conversationsB    Conversation[]      @relation("ConvB")
  sentMessages      Message[]           @relation("Sender")
  watchedLots       WatchedLot[]
  watchedShows      WatchedShow[]
  reviewsAsBuyer    Review[]            @relation("ReviewBuyer")
  reviewsAsSeller   Review[]            @relation("ReviewSeller")
  savedSearches     SavedSearch[]
  passwordResetTokens PasswordResetToken[]
  chatMessages      ChatMessage[]
  paymentMethods    UserPaymentMethod[]
  followingSellers  Follow[]            @relation("Follower")
  followedBy        Follow[]            @relation("Followed")
  lotsAsHighBidder  Lot[]               @relation("HighBidder")
  savedAddresses    UserAddress[]

  // Seller's return / ship-from address (used by ShipStation labels).
  // Stored as JSON to keep the User row narrow:
  //   { name, company?, phone?, street1, street2?, city, state, postalCode, country }
  shipFromAddress   Json?               @map("ship_from_address")
  // Default shipping cost (cents) pre-filled into new lots the seller
  // creates. Per-lot shippingCostCents always wins; this is just a UX
  // shortcut so they don't retype the same number on every lot.
  defaultShippingCents Int              @default(0) @map("default_shipping_cents")

  @@index([deletedAt])
  @@index([lockedAt])
  @@index([accountDeletedAt])
  @@map("users")
}

// Auth.js Prisma adapter tables.
model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// IP blocklist for banned users / abuse mitigation.
model IPBlocklist {
  id         String    @id @default(uuid()) @db.Uuid
  ipAddress  String    @unique @map("ip_address")
  userId     String?   @map("user_id") @db.Uuid
  reason     String?
  bannedById String?   @map("banned_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([ipAddress])
  @@index([expiresAt])
  @@map("ip_blocklist")
}

// User-supplied addresses (shipping). Multiple per user; one default.
model UserAddress {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  label       String?
  fullName    String  @map("full_name")
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String  @map("postal_code")
  country     String
  phone       String?
  isDefault   Boolean @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

// "Apply to sell" flow. Captures everything we need to KYC a seller
// before they're allowed to create shows. Modeled on the
// indiecrowdfund_2.0 creator-verification process: legal name + DOB,
// business filing, ID upload, social-media links, prior platforms,
// agreement acceptance. Bank account + chargeback card are stored in
// their own encrypted models.
model SellerApplication {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Identity
  legalFirstName String  @map("legal_first_name")
  legalLastName  String  @map("legal_last_name")
  dateOfBirth    DateTime @map("date_of_birth")
  phone          String

  // Address
  addressLine1   String  @map("address_line1")
  addressLine2   String? @map("address_line2")
  addressCity    String  @map("address_city")
  addressState   String  @map("address_state")
  addressZip     String  @map("address_zip")
  addressCountry String  @map("address_country")

  // Business
  storeName            String  @map("store_name")
  storeBio             String  @map("store_bio")
  businessFilingState  String? @map("business_filing_state")
  businessFilingNumber String? @map("business_filing_number")
  businessFilingUrl    String? @map("business_filing_url")
  taxIdLast4           String? @map("tax_id_last4")

  // Online presence
  primaryWebsite     String?  @map("primary_website")
  socialLinks        Json?    @map("social_links")
  priorPlatforms     Json?    @map("prior_platforms")
  unfulfilledCount   Int      @default(0) @map("unfulfilled_count")
  pastDeliveryIssues Boolean  @default(false) @map("past_delivery_issues")

  // Content categories the seller plans to list. Free-form for MVP.
  contentCategories String[] @map("content_categories")
  willListAdult     Boolean  @default(false) @map("will_list_adult")

  // Agreement
  agreedToSellerAgreementAt DateTime? @map("agreed_to_seller_agreement_at")
  agreedToContentPolicyAt   DateTime? @map("agreed_to_content_policy_at")
  agreedToNsfwPolicyAt      DateTime? @map("agreed_to_nsfw_policy_at")
  agreementVersion          String?   @map("agreement_version")

  // Review
  status          SellerApplicationStatus @default(draft)
  submittedAt     DateTime?               @map("submitted_at")
  reviewedAt      DateTime?               @map("reviewed_at")
  reviewedById    String?                 @map("reviewed_by_id") @db.Uuid
  reviewerNotes   String?                 @map("reviewer_notes")
  rejectionReason String?                 @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("seller_applications")
}

// Encrypted at rest via src/lib/encryption.ts (AES-256-GCM,
// BANK_ACCOUNT_ENCRYPTION_KEY). The naked PII never lives in plaintext.
// Display fields (bankNameDisplay, accountLastFour) duplicate the
// non-sensitive bits for UI without forcing a decrypt round-trip.
model PaymentCloudBankAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Which processor owns this row. NMI uses the encrypted PII directly
  // for ACH out; DC stores a Stripe Connect external account id in
  // `divinityCoinExternalAccountId` and the encrypted PII columns hold
  // the values used to bootstrap the Connect onboarding.
  processor                     PaymentProcessor @default(nmi)
  divinityCoinExternalAccountId String?          @map("divinitycoin_external_account_id")

  bankNameEncrypted               String @map("bank_name_encrypted")
  accountHolderFirstNameEncrypted String @map("account_holder_first_name_encrypted")
  accountHolderLastNameEncrypted  String @map("account_holder_last_name_encrypted")
  accountNumberEncrypted          String @map("account_number_encrypted")
  routingNumberEncrypted          String @map("routing_number_encrypted")

  billingLine1Encrypted   String  @map("billing_line1_encrypted")
  billingLine2Encrypted   String? @map("billing_line2_encrypted")
  billingCityEncrypted    String  @map("billing_city_encrypted")
  billingStateEncrypted   String  @map("billing_state_encrypted")
  billingZipEncrypted     String  @map("billing_zip_encrypted")
  billingCountryEncrypted String  @map("billing_country_encrypted")

  bankNameDisplay  String? @map("bank_name_display")
  accountLastFour  String? @map("account_last_four")
  accountType      String  @default("checking") @map("account_type")

  isVerified         Boolean   @default(false) @map("is_verified")
  verifiedAt         DateTime? @map("verified_at")
  verificationMethod String?   @map("verification_method")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_cloud_bank_accounts")
}

// Seller chargeback recovery card. PaymentCloud requires a card on
// file to recoup chargebacks if the rolling reserve isn't enough. PAN
// never touches our DB — only the processor's vault id + display data.
// `processor` says which gateway owns vaultId: 'nmi' uses an NMI
// customer_vault_id, 'divinitycoin' uses a Stripe payment_method id
// generated against DC's Stripe Connect account.
model SellerChargebackCard {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  processor          PaymentProcessor @default(nmi)
  nmiCustomerVaultId String           @unique @map("nmi_customer_vault_id")

  cardBrand    String? @map("card_brand")
  cardLastFour String  @map("card_last_four")
  expMonth     Int     @map("exp_month")
  expYear      Int     @map("exp_year")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_chargeback_cards")
}

model Seller {
  userId           String   @id @map("user_id") @db.Uuid
  storeName        String   @map("store_name")
  bio              String?
  payoutProvider   String?  @map("payout_provider")
  payoutAccountRef String?  @map("payout_account_ref")
  approved         Boolean  @default(false)
  approvedAt       DateTime? @map("approved_at")
  approvedById     String?   @map("approved_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sellers")
}

model Show {
  id            String     @id @default(uuid()) @db.Uuid
  sellerId      String     @map("seller_id") @db.Uuid
  title         String
  description   String?
  coverImageUrl String?    @map("cover_image_url")
  status        ShowStatus @default(scheduled)
  scheduledFor  DateTime?  @map("scheduled_for")
  startedAt     DateTime?  @map("started_at")
  endedAt       DateTime?  @map("ended_at")
  streamId      String?    @map("stream_id")
  recordingUrl  String?    @map("recording_url")
  // Optional pre-show trailer video the seller can upload. Plays on
  // the public show page when the show isn't live yet, and as a
  // preview thumbnail elsewhere.
  trailerUrl    String?    @map("trailer_url")
  // The "now selling" lot the seller wants spotlighted in the viewer.
  // Distinct from Lot.status='live' (which is the auction-engine bid
  // window). Sellers can pin a lot to highlight it before its auction
  // starts (e.g. "Coming up next") or while a Buy-Now lot is open.
  pinnedLotId   String?    @map("pinned_lot_id") @db.Uuid
  // When true, viewers in /s/[id] see a translucent chat overlay
  // pinned to the lower 1/3 of the video player. Toggled by the
  // seller from the Stream tab in the seller hub.
  chatOverlayEnabled Boolean @default(false) @map("chat_overlay_enabled")
  createdAt     DateTime   @default(now()) @map("created_at")

  seller       User          @relation("SellerShows", fields: [sellerId], references: [id], onDelete: Cascade)
  lots         Lot[]
  chatMessages ChatMessage[]
  watchers     WatchedShow[]

  @@index([sellerId])
  @@index([status])
  @@map("shows")
}

// Buyer-side watchlist. Two narrow tables — composite-keyed on
// (userId, lot/show id) so toggle is upsert/delete by the same key
// without a UUID lookup. Cascade-delete on either side so deleting a
// user/lot/show cleans up the bookmarks.
model WatchedLot {
  userId    String   @map("user_id") @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lot  Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@id([userId, lotId])
  @@index([userId, createdAt])
  @@index([lotId])
  @@map("watched_lots")
}

model WatchedShow {
  userId    String   @map("user_id") @db.Uuid
  showId    String   @map("show_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([userId, createdAt])
  @@index([showId])
  @@map("watched_shows")
}

model Lot {
  id                String    @id @default(uuid()) @db.Uuid
  // Nullable so lots can live in the 24/7 seller shop (no show
  // attached). When showId is null the lot is available for Buy-Now
  // purchase from the seller's profile any time.
  showId            String?   @map("show_id") @db.Uuid
  // Sellers may own 24/7-shop lots even when no show is attached;
  // sellerId is denormalized here so a single index works for both
  // shop browse and admin lookups.
  sellerId          String?   @map("seller_id") @db.Uuid
  position          Int
  kind              LotKind   @default(auction)
  title             String
  description       String?
  imageUrl          String?   @map("image_url")
  // Auction lot fields
  startingBidCents  Int       @map("starting_bid_cents")
  minIncrementCents Int       @default(100) @map("min_increment_cents")
  softCloseSeconds  Int       @default(10) @map("soft_close_seconds")
  // Buy-Now / mystery lot fields
  buyNowCents       Int?      @map("buy_now_cents")
  inventoryCount    Int       @default(1) @map("inventory_count")
  // Per-lot shipping cost charged on top of the lot price (in cents).
  // 0 = free shipping. Sellers set this when creating the lot;
  // defaults to User.defaultShippingCents at create time.
  shippingCostCents Int       @default(0) @map("shipping_cost_cents")
  // Mystery-specific: hidden contents revealed only after a successful
  // purchase. Stored as HTML (rich-text editor in seller UI). Buyers
  // see a generic placeholder until their order.status >= paid.
  mysteryContentsHtml String? @map("mystery_contents_html")
  // How many distinct items are bundled in the mystery box. Surfaces
  // on the buyer card ("3 items inside") to set expectations.
  mysteryItemCount  Int?      @map("mystery_item_count")
  status            LotStatus @default(queued)
  currentBidCents   Int?      @map("current_bid_cents")
  currentBidUserId  String?   @map("current_bid_user_id") @db.Uuid
  bidCount          Int       @default(0) @map("bid_count")
  startedAt         DateTime? @map("started_at")
  endsAt            DateTime? @map("ends_at")
  soldAt            DateTime? @map("sold_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  show          Show?   @relation(fields: [showId], references: [id], onDelete: Cascade)
  seller        User?   @relation("LotSeller", fields: [sellerId], references: [id])
  currentBidder User?   @relation("HighBidder", fields: [currentBidUserId], references: [id])
  bids          Bid[]
  orders        Order[]
  // Gallery: zero or more additional images on top of the cover
  // (Lot.imageUrl is still the lot's primary image — surfaced on
  // homepage cards / live overlay / order thumbnail). LotImage rows
  // power the gallery view on /shop, /orders/[id], and any future
  // lot detail page.
  images        LotImage[]
  watchers      WatchedLot[]

  @@index([showId])
  @@index([sellerId, status])
  @@index([kind, status])
  @@index([status])
  @@map("lots")
}

// Gallery image attached to a Lot. The Lot's primary image lives on
// Lot.imageUrl (kept for back-compat + cheap renders); this table
// stores the full image set so sellers can post front, back, and
// condition shots.
model LotImage {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, position])
  @@map("lot_images")
}

model Bid {
  id           String   @id @default(uuid()) @db.Uuid
  lotId        String   @map("lot_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  amountCents  Int      @map("amount_cents")
  accepted     Boolean
  rejectReason String?  @map("reject_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  lot  Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([userId])
  @@map("bids")
}

model Order {
  id                      String            @id @default(uuid()) @db.Uuid
  lotId                   String            @map("lot_id") @db.Uuid
  buyerId                 String            @map("buyer_id") @db.Uuid
  sellerId                String            @map("seller_id") @db.Uuid
  // Total charged to the buyer in cents (lot price + shippingCents).
  amountCents             Int               @map("amount_cents")
  // Portion of amountCents attributable to shipping (denormalized
  // from Lot.shippingCostCents at order creation time so refunds
  // and breakdowns work even if the lot is later edited).
  shippingCents           Int               @default(0) @map("shipping_cents")
  status                  OrderStatus       @default(pending_payment)
  paymentProcessor        PaymentProcessor? @map("payment_processor")
  nmiCustomerVaultId      String?           @map("nmi_customer_vault_id")
  nmiTransactionId        String?           @map("nmi_transaction_id")
  nmiInitialTransactionId String?           @map("nmi_initial_transaction_id")
  paidAt                  DateTime?         @map("paid_at")
  refundedAt              DateTime?         @map("refunded_at")
  nmiRefundId             String?           @map("nmi_refund_id")
  shippingAddress         String?           @map("shipping_address")
  // Shipping (ShipStation). Tracking can live either directly on the
  // Order (single-item shipment) OR on a Shipment grouping multiple
  // orders from the same buyer (Whatnot-style bundle). When
  // shipmentId is set the per-order shipping fields below are
  // redundant copies kept in sync with the Shipment row for cheap
  // queries.
  shipmentId              String?           @map("shipment_id") @db.Uuid
  shipstationShipmentId   String?           @map("shipstation_shipment_id")
  shippingCarrier         String?           @map("shipping_carrier")
  shippingService         String?           @map("shipping_service")
  shippingCostCents       Int?              @map("shipping_cost_cents")
  labelR2Key              String?           @map("label_r2_key")
  trackingNumber          String?           @map("tracking_number")
  shippedAt               DateTime?         @map("shipped_at")
  deliveredAt             DateTime?         @map("delivered_at")
  // Payout (Thursday batch on delivered orders)
  payoutId                String?           @map("payout_id") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at")

  lot       Lot       @relation(fields: [lotId], references: [id])
  buyer     User      @relation("Buyer", fields: [buyerId], references: [id])
  seller    User      @relation("Seller", fields: [sellerId], references: [id])
  payout    Payout?   @relation(fields: [payoutId], references: [id])
  shipment  Shipment? @relation(fields: [shipmentId], references: [id])
  review    Review?

  @@index([buyerId])
  @@index([sellerId])
  @@index([sellerId, deliveredAt, payoutId])
  @@index([shipmentId])
  @@map("orders")
}

// A Shipment groups one or more Orders from the same buyer into a
// single shipping label (Whatnot-style "bundle wins"). When a seller
// finalizes a bundle and buys a label, the resulting tracking +
// label PDF live on the Shipment, and the per-Order tracking fields
// are kept in sync as denormalized copies.
model Shipment {
  id                      String    @id @default(uuid()) @db.Uuid
  sellerId                String    @map("seller_id") @db.Uuid
  buyerId                 String    @map("buyer_id") @db.Uuid
  shipstationShipmentId   String?   @map("shipstation_shipment_id")
  shippingCarrier         String?   @map("shipping_carrier")
  shippingService         String?   @map("shipping_service")
  shippingCostCents       Int?      @map("shipping_cost_cents")
  labelR2Key              String?   @map("label_r2_key")
  trackingNumber          String?   @map("tracking_number")
  shippedAt               DateTime? @map("shipped_at")
  deliveredAt             DateTime? @map("delivered_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  orders Order[]

  @@index([sellerId, buyerId])
  @@index([trackingNumber])
  @@map("shipments")
}

// Buyer-authored review of the seller after a delivered order. One
// review per order — orderId is unique. Surfaces on /shop/[handle]
// as a star average + count plus the most-recent comments.
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  rating    Int      // 1..5
  body      String?  // optional text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer  User  @relation("ReviewBuyer", fields: [buyerId], references: [id])
  seller User  @relation("ReviewSeller", fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
  @@index([buyerId])
  @@map("reviews")
}

// Buyer-saved search. Daily cron walks each row, finds new lots
// created since lastEmailedAt that match the query, and emails the
// buyer. Manageable from /account/saved-searches.
model SavedSearch {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  query         String    @db.VarChar(200)
  lastEmailedAt DateTime? @map("last_emailed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastEmailedAt])
  @@map("saved_searches")
}

// One row per seller per weekly batch (Thursday). Holds the aggregated
// amount paid out plus the underlying ledger of orders. Created when
// the weekly run dispatches the DivinityCoin payout; orders link back
// via Order.payoutId.
model Payout {
  id                String   @id @default(uuid()) @db.Uuid
  sellerId          String   @map("seller_id") @db.Uuid
  weekEnding        DateTime @map("week_ending") @db.Date
  grossCents        Int      @map("gross_cents")
  feeCents          Int      @map("fee_cents")
  shippingCents     Int      @default(0) @map("shipping_cents")
  netCents          Int      @map("net_cents")
  status            PayoutStatus @default(pending)
  dcTransactionId   String?  @map("dc_transaction_id")
  failureReason     String?  @map("failure_reason")
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  seller User    @relation("PayoutSeller", fields: [sellerId], references: [id])
  orders Order[]

  @@unique([sellerId, weekEnding])
  @@index([status])
  @@map("payouts")
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
}

model ChatMessage {
  id        String    @id @default(uuid()) @db.Uuid
  showId    String    @map("show_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  body      String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([showId, createdAt])
  @@map("chat_messages")
}

model UserPaymentMethod {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  processor            PaymentProcessor
  vaultId              String           @map("vault_id")
  cardBrand            String?          @map("card_brand")
  cardLast4            String?          @map("card_last4")
  cardExpMonth         Int?             @map("card_exp_month")
  cardExpYear          Int?             @map("card_exp_year")
  initialTransactionId String?          @map("initial_transaction_id")
  isDefault            Boolean          @default(false) @map("is_default")
  deletedAt            DateTime?        @map("deleted_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([processor, vaultId])
  @@index([userId])
  @@map("user_payment_methods")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  seller   User @relation("Followed", fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([followerId, sellerId])
  @@map("follows")
}

// Admin action audit log. Every privileged action that touches a
// Mailbox row. Stores both inbound mail (received via SendGrid Inbound
// Parse webhook) and outbound mail (composed in /admin/inbox/compose,
// sent via SendGrid). One table so staff can scroll a unified history.
model InboundEmail {
  id          String   @id @default(uuid()) @db.Uuid
  direction   EmailDirection @default(inbound)
  fromEmail   String   @map("from_email")
  fromName    String?  @map("from_name")
  toEmail     String   @map("to_email")
  ccEmails    String[] @default([]) @map("cc_emails")
  bccEmails   String[] @default([]) @map("bcc_emails")
  subject     String   @default("")
  text        String?
  html        String?
  spamScore   Float?   @map("spam_score")
  raw         Json?
  readAt      DateTime? @map("read_at")
  starred     Boolean  @default(false)
  archivedAt  DateTime? @map("archived_at")
  receivedAt  DateTime @default(now()) @map("received_at")

  attachments InboundEmailAttachment[]

  @@index([receivedAt])
  @@index([toEmail])
  @@index([direction, archivedAt])
  @@map("inbound_emails")
}

enum EmailDirection {
  inbound
  outbound
}

model InboundEmailAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  emailId     String   @map("email_id") @db.Uuid
  filename    String
  contentType String?  @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  r2Key       String   @map("r2_key")
  createdAt   DateTime @default(now()) @map("created_at")

  email InboundEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("inbound_email_attachments")
}

// user, order, or seller-facing setting writes one row. Append-only;
// no updates / deletes from app code.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  targetKind String? @map("target_kind")
  targetId   String? @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetKind, targetId])
  @@map("audit_logs")
}

// Auto-banned IPs from the bot blocker. Distinct from IPBlocklist
// (admin-initiated). Has a 24h expiration by default and tracks
// violation count for repeat offenders. The botblock-watcher service
// reads /tmp/botblock-pending every 5s and adds an iptables DROP
// rule, so blocks land in the kernel firewall too.
model BlockedIP {
  id             String   @id @default(uuid()) @db.Uuid
  ipAddress      String   @unique @map("ip_address")
  reason         String
  violationCount Int      @default(1) @map("violation_count")
  blockedAt      DateTime @default(now()) @map("blocked_at")
  expiresAt      DateTime @map("expires_at")

  // Last-seen metadata for triage
  lastUserAgent String? @map("last_user_agent")
  lastPath      String? @map("last_path")
  lastActionId  String? @map("last_action_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ipAddress])
  @@index([expiresAt])
  @@map("blocked_ips")
}

// Audit log of detected suspicious behavior. Three hits within
// SUSPICIOUS_WINDOW_MS escalates to a BlockedIP entry.
model SuspiciousActivity {
  id        String   @id @default(uuid()) @db.Uuid
  ipAddress String   @map("ip_address")
  reason    String
  actionId  String?  @map("action_id")
  path      String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipAddress, createdAt])
  @@map("suspicious_activity")
}
