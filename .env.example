# Postgres (Neon, Supabase, RDS, or self-hosted)
DATABASE_URL=postgres://user:pass@host:5432/indiecomicslive

# Auth.js
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Email (magic-link sign in). Resend recommended.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@indiecomics.live

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_PLAYBACK_POLICY=signed

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=indiecomicslive
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# WebSocket server (auction + chat)
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Age verification (Persona, Yoti, etc.) - stub for MVP
AGE_VERIFY_PROVIDER=stub
