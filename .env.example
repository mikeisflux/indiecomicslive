# Public site URL — used for canonical, OpenGraph, sitemap, robots
NEXT_PUBLIC_SITE_URL=https://indiecomicslive.com

# PostgreSQL 17+ (Neon, Supabase, RDS, or self-hosted)
DATABASE_URL=postgres://user:pass@host:5432/indiecomicslive

# Auth.js
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Email (magic-link sign in). SendGrid HTTP API.
AUTH_SENDGRID_KEY=
AUTH_EMAIL_FROM=noreply@indiecomicslive.com

# Ant Media Server (self-hosted from the Anthill repo).
# JWT secret must match the value set in Ant Media's
# "JWT Stream Security Settings" panel.
ANT_MEDIA_HOST=stream.indiecomicslive.com
ANT_MEDIA_PORT=5443
ANT_MEDIA_APP=WebRTCAppEE
ANT_MEDIA_JWT_SECRET=replace_me_match_ant_media_panel
ANT_MEDIA_WEBHOOK_SECRET=replace_me
ANT_MEDIA_REST_USER=
ANT_MEDIA_REST_PASS=
NEXT_PUBLIC_ANT_MEDIA_APP=WebRTCAppEE

# PaymentCloud (NMI Direct Post + CollectJS).
# securityKey from the PaymentCloud merchant portal.
# publicKey is the CollectJS tokenization key, public by design.
NMI_SECURITY_KEY=
NMI_PUBLIC_KEY=
NMI_WEBHOOK_SECRET=
NMI_ENVIRONMENT=production
# Override only if your reseller proxies NMI on a different host.
# NMI_GATEWAY_URL=https://paymentcloud.transactiongateway.com/api/transact.php

# Cloudflare R2 (images + VOD)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=indiecomicslive
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# TURN server (coturn `use-auth-secret` mode). Required for reliable
# WebRTC behind symmetric NAT / restrictive firewalls. The shared
# secret must match coturn's `static-auth-secret`.
TURN_HOST=turn.indiecomicslive.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=indiecomicslive.com
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=21600

# Encryption-at-rest for seller bank account PII (AES-256-GCM, 32 bytes
# base64). Generate with `openssl rand -base64 32`.
BANK_ACCOUNT_ENCRYPTION_KEY=

# WebSocket server (auction + chat)
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

