# Public site URL — used for canonical, OpenGraph, sitemap, robots
NEXT_PUBLIC_SITE_URL=https://indiecomicslive.com

# PostgreSQL 17+ (Neon, Supabase, RDS, or self-hosted)
DATABASE_URL=postgres://user:pass@host:5432/indiecomicslive

# Auth.js
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Email (magic-link sign in for regular users). SendGrid HTTP API.
AUTH_SENDGRID_KEY=
AUTH_EMAIL_FROM=noreply@indiecomicslive.com

# Admin credentials login at /staff-sign-in. The hash is scrypt-format,
# generated by `npx tsx scripts/admin-set-password.ts <email> <password>`.
# Without these, /admin is unreachable for staff (only magic-link
# users that grant-admin promoted will be able to enter).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Ant Media Server (self-hosted from the Anthill repo).
# JWT secret must match the value set in Ant Media's
# "JWT Stream Security Settings" panel.
ANT_MEDIA_HOST=stream.indiecomicslive.com
ANT_MEDIA_PORT=5443
ANT_MEDIA_APP=WebRTCAppEE
ANT_MEDIA_JWT_SECRET=replace_me_match_ant_media_panel
ANT_MEDIA_WEBHOOK_SECRET=replace_me
ANT_MEDIA_REST_USER=
ANT_MEDIA_REST_PASS=
NEXT_PUBLIC_ANT_MEDIA_APP=WebRTCAppEE

# PaymentCloud (NMI Direct Post + CollectJS).
# securityKey from the PaymentCloud merchant portal.
# publicKey is the CollectJS tokenization key, public by design.
NMI_SECURITY_KEY=
NMI_PUBLIC_KEY=
NMI_WEBHOOK_SECRET=
NMI_ENVIRONMENT=production
# Override only if your reseller proxies NMI on a different host.
# NMI_GATEWAY_URL=https://paymentcloud.transactiongateway.com/api/transact.php

# Cloudflare R2 (images + VOD)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=indiecomicslive
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# TURN server (coturn `use-auth-secret` mode). Required for reliable
# WebRTC behind symmetric NAT / restrictive firewalls. The shared
# secret must match coturn's `static-auth-secret`.
TURN_HOST=turn.indiecomicslive.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=indiecomicslive.com
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=21600

# Encryption-at-rest for seller bank account PII (AES-256-GCM, 32 bytes
# base64). Generate with `openssl rand -base64 32`.
BANK_ACCOUNT_ENCRYPTION_KEY=

# WebSocket server (auction + chat)
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Stable encryption key for Next.js Server Actions. Without a stable
# value here, Next regenerates the key on every `next build` and every
# active browser tab logs out of its server actions on the next deploy
# ("Failed to find Server Action 'x'"). Generate once with:
#   openssl rand -base64 32
# and set the SAME value on every server / replica. Never commit the
# real value.
SERVER_ACTIONS_ENCRYPTION_KEY=

# ShipStation (master account model — one set of API creds for the
# whole platform; sellers print labels via our UI). API key + secret
# from ShipStation → Settings → Account → API Settings.
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Custom secret used to authenticate inbound ShipStation webhooks.
# Configure ShipStation → Settings → Integrations → Webhooks to POST
# to /api/webhooks/shipstation?token=<this value>.
SHIPSTATION_WEBHOOK_SECRET=

# Platform fee in basis points charged to sellers on each delivered
# order at payout time (1000 = 10%). Shipping cost is reimbursed in
# full to the seller on top of net.
PLATFORM_FEE_BPS=1000

# Cron secret for /api/cron/payouts. The Thursday weekly job hits
# this endpoint via system cron with `Authorization: Bearer <this>`
# header. Generate with `openssl rand -base64 32`.
CRON_SECRET=

